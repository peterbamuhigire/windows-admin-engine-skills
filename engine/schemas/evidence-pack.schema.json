{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","engine_version","created_at","operation","files","limitations","verdict"],
  "properties":{
    "schema_version":{"const":"1.0"}, "engine_version":{"type":"string"}, "created_at":{"type":"string"},
    "operation":{"type":"string"}, "files":{"type":"array","items":{"type":"object","required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}}}},
    "limitations":{"type":"array","items":{"type":"string"}}, "verdict":{"enum":["PASS","FAIL","PARTIAL","NOT_ASSESSED"]}
  }
}
