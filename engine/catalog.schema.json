{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techguypeter.com/windows-skills/catalog.schema.json",
  "title": "Windows skills catalogue",
  "type": "object",
  "required": ["schema_version", "engine_version", "skills"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "engine_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "category", "trigger", "exclusions", "platforms", "risk_class", "maturity", "owner", "last_verified", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "path": {"type": "string", "pattern": "^[^\\\\]+/SKILL\\.md$"},
          "category": {"type": "string"},
          "trigger": {"type": "string", "minLength": 12},
          "exclusions": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "risk_class": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5"]},
          "script_tier": {"enum": ["none", "read-only", "controlled-mutation", "blocked"]},
          "maturity": {"enum": ["SUPPORTED", "LAB_VALIDATED", "PARTIAL", "EXPERIMENTAL", "BLOCKED", "NOT_ASSESSED", "DEPRECATED"]},
          "owner": {"type": "string", "minLength": 1},
          "last_verified": {"type": "string", "format": "date"},
          "sources": {"type": "array", "items": {"type": "string"}},
          "keywords": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
